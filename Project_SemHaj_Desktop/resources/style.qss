QWidget {font-family: "Segoe UI"; font-size: 13px; color: #203344;} QMainWindow,QDialog {background: #f4f7fa;} QLabel#headingLabel,QLabel#titleLabel {font-size: 22px; font-weight: bold; padding: 10px;} QPushButton {background: #e3edf2; border: 1px solid #c3d6df; padding: 9px 14px; border-radius: 5px;} QPushButton:hover {background: #cfe4ec;} QPushButton:disabled {color: #87959c; background: #e6eaec;} QPushButton#refreshButton,QPushButton#loginButton {background: #176b83; color: white;} QLineEdit,QComboBox,QListWidget,QTextBrowser,QTableWidget {background: white; border: 1px solid #d5dfe7; border-radius: 4px; padding: 5px;} QTableWidget {gridline-color: #e1e8ee; alternate-background-color: #eef5f8;} QHeaderView::section {background: #e3edf2; padding: 8px; border: none;} QListWidget::item {padding: 7px;} QListWidget::item:selected {background: #176b83; color: white;} QTabWidget::pane {border: 1px solid #d5dfe7; background: white;} QTabBar::tab {padding: 10px 18px; background: #e3edf2;} QTabBar::tab:selected {background: white; color: #176b83;} QLabel#statusLabel {padding: 8px; color: #536977;}

QScrollArea, QWidget#fieldsArea {background: white;} QHeaderView {background: #e3edf2;} QTableCornerButton::section {background: #e3edf2; border: 1px solid #d5dfe7;}
